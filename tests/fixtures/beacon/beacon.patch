+++ b/zircon/kernel/object/include/object/beacon_dispatcher.h
@@ -13,6 +13,17 @@
 
 #include <object/dispatcher.h>
 
+class BeaconDispatcher;
+extern "C" {
+zx_status_t rust_beacon_dispatcher_subscribe(BeaconDispatcher* beacon, uint64_t key,
+                                             uint32_t* out_index);
+zx_status_t rust_beacon_dispatcher_unsubscribe(BeaconDispatcher* beacon, uint64_t key);
+zx_status_t rust_beacon_dispatcher_flash(BeaconDispatcher* beacon, uint32_t mode);
+zx_status_t rust_beacon_dispatcher_get_subscriber(const BeaconDispatcher* beacon, uint32_t index,
+                                                  uint64_t* out_key);
+uint64_t rust_beacon_dispatcher_flash_count(const BeaconDispatcher* beacon);
+}
+
 class BeaconDispatcher final : public SoloDispatcher<BeaconDispatcher, ZX_DEFAULT_BEACON_RIGHTS> {
  public:
   static zx_status_t Create(uint32_t options, KernelHandle<BeaconDispatcher>* handle,
