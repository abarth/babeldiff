diff --git a/zircon/kernel/object/beacon_dispatcher.rs b/zircon/kernel/object/beacon_dispatcher.rs
new file mode 100644
index 0000000..3cc1117
--- /dev/null
+++ b/zircon/kernel/object/beacon_dispatcher.rs
@@ -0,0 +1,101 @@
+// Copyright 2026 The Fuchsia Authors
+//
+// Use of this source code is governed by a MIT-style
+// license that can be found in the LICENSE file or at
+// https://opensource.org/licenses/MIT
+
+// A synthetic dispatcher used to test babeldiff. It is not part of Zircon.
+
+use crate::object::dispatcher::StateLockGuard;
+use zx_status::Status;
+use zx_types::{
+    ZX_BEACON_FLASHED, ZX_BEACON_MODE_BURST, ZX_BEACON_MODE_MAX, ZX_BEACON_MODE_ONCE,
+    ZX_BEACON_MODE_REPEAT,
+};
+
+const MAX_SUBSCRIBERS: u32 = 8;
+const BURST_LENGTH: u64 = 3;
+
+impl BeaconDispatcher {
+    /// Adds `key` to the subscribers and returns its index.
+    ///
+    /// Returns ZX_ERR_NO_RESOURCES if the beacon already has the maximum number of subscribers.
+    pub fn subscribe(&self, key: u64) -> Result<u32, Status> {
+        ksync::lock!(let mut guard = self.lock());
+        if guard.subscriber_count >= MAX_SUBSCRIBERS {
+            return Err(Status::NO_RESOURCES);
+        }
+        // Keys must be unique so that Unsubscribe can find them.
+        for i in 0..guard.subscriber_count {
+            if guard.subscribers[i as usize] == key {
+                return Err(Status::ALREADY_EXISTS);
+            }
+        }
+        let index = guard.subscriber_count;
+        guard.subscribers[index as usize] = key;
+        guard.subscriber_count += 1;
+        Ok(index)
+    }
+
+    /// Removes `key` from the subscribers.
+    pub fn unsubscribe(&self, key: u64) -> Result<(), Status> {
+        ksync::lock!(let mut guard = self.lock());
+        for i in 0..guard.subscriber_count {
+            if guard.subscribers[i as usize] == key {
+                // Swap the last subscriber into the hole.
+                guard.subscriber_count -= 1;
+                let last = guard.subscribers[guard.subscriber_count as usize];
+                guard.subscribers[i as usize] = last;
+                return Ok(());
+            }
+        }
+        Err(Status::NOT_FOUND)
+    }
+
+    /// Flashes the beacon in `mode`, waking every subscriber.
+    pub fn flash(&self, mode: u32) -> Result<(), Status> {
+        Self::check_mode(mode)?;
+        ksync::lock!(let mut guard = self.lock());
+        match mode {
+            ZX_BEACON_MODE_ONCE => guard.flashes += 1,
+            ZX_BEACON_MODE_REPEAT | ZX_BEACON_MODE_BURST => guard.flashes += BURST_LENGTH,
+            _ => return Err(Status::NOT_SUPPORTED),
+        }
+        self.update_state_locked(&mut guard, 0, ZX_BEACON_FLASHED);
+        Ok(())
+    }
+
+    fn check_mode(mode: u32) -> Result<(), Status> {
+        if mode <= ZX_BEACON_MODE_MAX { Ok(()) } else { Err(Status::INVALID_ARGS) }
+    }
+
+    /// Returns the key of the subscriber at `index`.
+    ///
+    /// # Safety
+    ///
+    /// Nothing here is unsafe; the section exists to test that babeldiff
+    /// expects safety documentation in Rust.
+    pub fn get_subscriber(&self, index: u32) -> Result<u64, Status> {
+        ksync::lock!(let guard = self.lock());
+        let key = self.find_locked(&guard, index).ok_or(Status::OUT_OF_RANGE)?;
+        Ok(*key)
+    }
+
+    /// Returns how many times the beacon has flashed.
+    pub fn flash_count(&self) -> u64 {
+        ksync::lock!(let guard = self.lock.lock());
+        let token = guard.token();
+        // SAFETY: `token` proves the lock is held.
+        unsafe { *self.flashes.get(&token) }
+    }
+
+    fn find_locked<'a>(&self, guard: &'a StateLockGuard<'_>, index: u32) -> Option<&'a u64> {
+        if index < guard.subscriber_count {
+            // SAFETY: `index` is below `subscriber_count`, which never exceeds the array's
+            // length.
+            Some(unsafe { guard.subscribers.get_unchecked(index as usize) })
+        } else {
+            None
+        }
+    }
+}
diff --git a/zircon/kernel/object/beacon_dispatcher_ffi.rs b/zircon/kernel/object/beacon_dispatcher_ffi.rs
new file mode 100644
index 0000000..14d44a5
--- /dev/null
+++ b/zircon/kernel/object/beacon_dispatcher_ffi.rs
@@ -0,0 +1,64 @@
+// Copyright 2026 The Fuchsia Authors
+//
+// Use of this source code is governed by a MIT-style
+// license that can be found in the LICENSE file or at
+// https://opensource.org/licenses/MIT
+
+use super::beacon_dispatcher::BeaconDispatcher;
+use zx_types::{ZX_OK, zx_status_t};
+
+/// # Safety
+///
+/// `out_index` must be valid for writes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rust_beacon_dispatcher_subscribe(
+    beacon: &BeaconDispatcher,
+    key: u64,
+    out_index: *mut u32,
+) -> zx_status_t {
+    match beacon.subscribe(key) {
+        Ok(index) => {
+            // SAFETY: The caller guarantees `out_index` is valid for writes.
+            unsafe { *out_index = index };
+            ZX_OK
+        }
+        Err(status) => status.into_raw(),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_beacon_dispatcher_unsubscribe(
+    beacon: &BeaconDispatcher,
+    key: u64,
+) -> zx_status_t {
+    Status::from_result(beacon.unsubscribe(key))
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_beacon_dispatcher_flash(beacon: &BeaconDispatcher, mode: u32) -> zx_status_t {
+    Status::from_result(beacon.flash(mode))
+}
+
+/// # Safety
+///
+/// `out_key` must be valid for writes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rust_beacon_dispatcher_get_subscriber(
+    beacon: &BeaconDispatcher,
+    index: u32,
+    out_key: *mut u64,
+) -> zx_status_t {
+    match beacon.get_subscriber(index) {
+        Ok(key) => {
+            // SAFETY: The caller guarantees `out_key` is valid for writes.
+            unsafe { *out_key = key };
+            ZX_OK
+        }
+        Err(status) => status.into_raw(),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_beacon_dispatcher_flash_count(beacon: &BeaconDispatcher) -> u64 {
+    beacon.flash_count()
+}
diff --git a/zircon/kernel/object/include/object/beacon_dispatcher.h b/zircon/kernel/object/include/object/beacon_dispatcher.h
index 2329b8f..3a71b52 100644
